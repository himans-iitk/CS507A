.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.env

# API cache and bulky raw downloads are regenerable
data/cache/
data/raw/*
!data/raw/.gitkeep

# regenerable logs
data/processed/*.log

# labelling tool access token
coding/.labeltool_token

# Slurm and vLLM logs
logs/*
!logs/.gitkeep

# embedding caches (regenerable, large)
data/processed/embeddings/

# LaTeX build files
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/main.pdf
